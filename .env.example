# Public site URL (used for metadata, sitemap, magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (local defaults come from `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by /api/track/* to write profile_events. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Mapbox token for /api/geocode free-text fallback (nearest listed city)
MAPBOX_ACCESS_TOKEN=
